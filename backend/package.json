{
  "name": "dragonlost-backend",
  "version": "1.0.0",
  "description": "DragonLost Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "migrate:014": "node scripts/run-sql-migration.mjs database/migrations/014-telegram-bot.sql",
    "migrate:015": "node scripts/run-sql-migration.mjs database/migrations/015-conveyor-filters.sql",
    "migrate:017": "node scripts/run-sql-migration.mjs database/migrations/017-payment-audit-retention.sql",
    "migrate:018": "node scripts/run-sql-migration.mjs database/migrations/018-conveyor-filter-cover-category.sql",
    "migrate:019": "node scripts/run-sql-migration.mjs database/migrations/019-telegram-wipe-subscribers.sql",
    "migrate:020": "node scripts/run-sql-migration.mjs database/migrations/020-shop-bundles.sql",
    "migrate:021": "node scripts/run-sql-migration.mjs database/migrations/021-voucher-wipe-repeat.sql",
    "migrate:022": "node scripts/run-sql-migration.mjs database/migrations/022-voucher-codes-missing-columns.sql",
    "migrate:023": "node scripts/run-sql-migration.mjs database/migrations/023-shop-bundles-images.sql"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/passport": "^1.0.16",
    "@types/passport-steam": "^1.0.5",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
